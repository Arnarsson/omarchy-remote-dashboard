#!/bin/bash
# Omarchy Remote.app launcher: pick a mode, then run the bundled omarchy-connect.
# GUI only: dialogs and notifications instead of a terminal. Log: ~/Library/Logs/omarchy-remote.log
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"   # GUI apps start with a minimal PATH
export OMARCHY_GUI=1
export OMARCHY_MENU_AUDIO=1   # sound choice is a menu toggle here, so the client skips its dialog
export OMARCHY_T0=$(date +%s)
HERE="$(cd "$(dirname "$0")/../Resources" && pwd)"
APPLOG="$HOME/Library/Logs/omarchy-remote.log"
mkdir -p "$(dirname "$APPLOG")"

export OMARCHY_T_UPDATE=$(date +%s)
# Self-update: take the newest client from the host (fixes land without rerunning setup).
conf="$HOME/.config/omarchy-stream/client.env"
if [[ -f $conf ]]; then
  # shellcheck disable=SC1090
  source "$conf"
  new=$(mktemp)
  if curl -fsS -m 3 -H "Authorization: Bearer ${TOKEN:-}" "http://$HOST:$DASHBOARD_PORT/mac/omarchy-connect" -o "$new" 2>/dev/null \
     && head -1 "$new" | grep -q '^#!/usr/bin/env bash' && bash -n "$new" && ! cmp -s "$new" "$HERE/omarchy-connect"; then
    cp "$new" "$HERE/omarchy-connect" && chmod +x "$HERE/omarchy-connect"
  fi
  rm -f "$new"
fi

export OMARCHY_T_MENU=$(date +%s)
V="Screen sized to this Mac"; M="Main monitor (ultrawide)"; A="All three monitors"; C="Check connection"
while true; do
  # Settings toggles live in the same list; picking one flips it and shows the list again.
  CLIPBOARD=1; [[ -f $conf ]] && CLIPBOARD=$(grep -E '^CLIPBOARD=' "$conf" | tail -1 | cut -d= -f2); CLIPBOARD=${CLIPBOARD:-1}
  if [[ $CLIPBOARD == 1 ]]; then K="Clipboard sync: On (turn off)"; else K="Clipboard sync: Off (turn on)"; fi
  AUDIO=mac; [[ -f $conf ]] && AUDIO=$(grep -E '^AUDIO=' "$conf" | tail -1 | cut -d= -f2); AUDIO=${AUDIO:-mac}
  if [[ $AUDIO == host ]]; then S="Sound: Omarchy speakers (switch to Mac)"; else S="Sound: this Mac (switch to Omarchy)"; fi
  choice=$(osascript -e "choose from list {\"$V\", \"$M\", \"$A\", \"$C\", \"$S\", \"$K\"} with title \"Omarchy Remote\" with prompt \"Connect to Omarchy:\" default items {\"$V\"}" 2>/dev/null)
  case "$choice" in
    "$V") mode=virtual; break ;;
    "$M") mode=all; break ;;
    "$A") mode=multi; break ;;
    "$C") mode=check; break ;;
    "$S") if [[ $AUDIO == host ]]; then new=mac; else new=host; fi
          if grep -q '^AUDIO=' "$conf"; then sed -i.bak "s/^AUDIO=.*/AUDIO=$new/" "$conf" && rm -f "$conf.bak"
          else echo "AUDIO=$new" >> "$conf"; fi ;;
    "$K") new=$(( 1 - CLIPBOARD ))
          if grep -q '^CLIPBOARD=' "$conf"; then sed -i.bak "s/^CLIPBOARD=.*/CLIPBOARD=$new/" "$conf" && rm -f "$conf.bak"
          else echo "CLIPBOARD=$new" >> "$conf"; fi ;;
    *) exit 0 ;;   # cancelled
  esac
done

export OMARCHY_T_CHOSEN=$(date +%s)   # so the report separates "time in the menu" from launch work
echo "=== $(date) $mode" >> "$APPLOG"
tmp=$(mktemp)
"$HERE/omarchy-connect" "$mode" > "$tmp" 2>&1; rc=$?
cat "$tmp" >> "$APPLOG"; out=$(cat "$tmp"); rm -f "$tmp"
path=$(grep -m1 '^path:' <<<"$out" | sed 's/"/\\"/g')
if [[ $rc -ne 0 ]]; then
  msg=$(grep -E '✘|Set TOKEN|refused|unreachable' <<<"$out" | tail -1 | sed 's/"/\\"/g')
  osascript -e "display dialog \"${msg:-Something went wrong.}\n\nDetails: ~/Library/Logs/omarchy-remote.log\" with title \"Omarchy Remote\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null
elif [[ $mode == check ]]; then
  osascript -e "display dialog \"${path:-No result}\" with title \"Omarchy Remote\" buttons {\"OK\"} default button 1" >/dev/null
fi
