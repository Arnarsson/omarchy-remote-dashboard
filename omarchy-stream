HOME = Path.home()
SUNSHINE_DIR = HOME / ".config/sunshine"
SUNSHINE_CONF = SUNSHINE_DIR / "sunshine.conf"
SUNSHINE_LOG = SUNSHINE_DIR / "sunshine.log"
INSTANCES_DIR = SUNSHINE_DIR / "instances"
STATE_DIR = HOME / ".config/omarchy-stream"
TOKEN_FILE = STATE_DIR / "token"
APP_DIR = Path(__file__).resolve().parent
CONFIG_FILE = STATE_DIR / "config.json"
SESSION_FILE = STATE_DIR / "session.json"
DEFAULT_CONFIG = {
    "disable_vrr_while_streaming": True,   # VRR makes captured frame timing uneven
    # Off by default: when you're remote, a locked host can strand you. Turn on for unattended desks.
    "lock_on_disconnect": False,
    # Off by default: Moonlight runs in capture mode (host cursor only). Hiding it left no cursor at all.
    "hide_host_cursor_while_streaming": False,
    "stream_keys": True,                   # Ctrl+Alt+1..5 bring workspace N here, Ctrl+Alt+Q disconnects
    "sunshine_unit": "sunshine",           # user unit of the main (all-monitors) Sunshine; install.sh detects it
    "sunshine_bin": "",                    # Sunshine binary that unit runs; empty = first on PATH
    "dashboard_port": 8080,
}


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        cfg.update(json.loads(CONFIG_FILE.read_text()))
    except (OSError, json.JSONDecodeError):
        pass
    return cfg


def main_unit():
    return load_config()["sunshine_unit"]


def sunshine_bin():
    return load_config()["sunshine_bin"] or shutil.which("sunshine") or "sunshine"


# Seconds to let Hyprland settle (hotplug scripts may `hyprctl reload` right after an output appears).
SETTLE = float(os.environ.get("OMARCHY_SETTLE", "1"))

# Sunshine options that only exist on Windows; on Linux they are silently ignored.
WINDOWS_ONLY_KEYS = {
    "nvenc_realtime_hags": "Hardware GPU scheduling is a Windows feature.",
    "nvenc_latency_over_power": "Windows-only NVENC power setting.",
}

# Each instance uses ports base-5 .. base+21, so 100 apart never overlap.
BASE_PORT = 47989
PORT_STEP = 100


def run(args, timeout=5):
    """Run a command without a shell. Returns (stdout, returncode)."""
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip(), r.returncode
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e), 127


def read_conf(path):
    conf = {}
    try:
        for line in Path(path).read_text().splitlines():
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


# --------------------------------------------------------------------------- monitors

def hypr_monitors():
    out, code = run(["hyprctl", "monitors", "-j"])
    if code != 0:
        return []
    try:
        mons = json.loads(out)
    except json.JSONDecodeError:
        return []
    return sorted(mons, key=lambda m: (m.get("x", 0), m.get("y", 0)))


def desktop_size(mons):
    if not mons:
        return None
    def scaled(m, k):
        return round(m[k] / (m.get("scale") or 1))
    right = max(m["x"] + scaled(m, "width") for m in mons)
    bottom = max(m["y"] + scaled(m, "height") for m in mons)
    left = min(m["x"] for m in mons)
    top = min(m["y"] for m in mons)
    return right - left, bottom - top


def cmd_monitors(_args):
    mons = hypr_monitors()
    if not mons:
        print("No monitors from hyprctl (is Hyprland running in this session?)")
        return 1
    for i, m in enumerate(mons):
        print(f"[{i}] {m['name']:<10} {m['width']}x{m['height']}@{m['refreshRate']:.0f}Hz"
              f"  pos {m['x']},{m['y']}  scale {m.get('scale', 1)}  {m.get('description', '')}")
    w, h = desktop_size(mons)
    print(f"\nCombined desktop: {w}x{h}  ->  use this as Moonlight's custom resolution"
          " for the all-monitors stream.")
    return 0


# --------------------------------------------------------------------------- doctor

def check(name, status, detail, fix=None):
    return {"check": name, "status": status, "detail": detail, "fix": fix}


def tailscale_peers():
    out, code = run(["tailscale", "status", "--json"])
    if code != 0:
        return None, []
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return None, []
    peers = []
    for p in (data.get("Peer") or {}).values():
        peers.append({
            "name": p.get("HostName"),
            "os": p.get("OS"),
            "online": bool(p.get("Online")),
            # Idle peers have no CurAddr either; only an active peer's path means anything.
            "active": bool(p.get("Active")),
            "ip": (p.get("TailscaleIPs") or [None])[0],
            # CurAddr set = direct UDP path; otherwise traffic goes through a DERP relay.
            "direct": bool(p.get("CurAddr")),
            "endpoint": p.get("CurAddr") or None,
            "relay": p.get("Relay") or None,
        })
    return data, peers


def detect_encoder():
    try:
        log = SUNSHINE_LOG.read_text(errors="replace")[-200_000:]
    except OSError:
        return None
    found = re.findall(r"Found (?:H\.264|HEVC|AV1) encoder: (\S+) \[(\w+)\]", log)
    if found:
        return sorted({f"{codec} [{kind}]" for codec, kind in found})
    if re.search(r"software encoder|libx264|libx265", log, re.I):
        return ["software"]
    return None


def cmd_doctor_results():
    results = []

    session = os.environ.get("XDG_SESSION_TYPE", "unknown")
    hypr = bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))
    results.append(check("session", "ok" if hypr else "warn",
                         f"{session}, Hyprland={'yes' if hypr else 'no'}",
                         None if hypr else "Run doctor from inside your Hyprland session."))

    sunshine = load_config()["sunshine_bin"] or shutil.which("sunshine")
    if not sunshine:
        results.append(check("sunshine", "fail", "sunshine not installed",
                             "yay -S sunshine   (or: sunshine-bin)"))
    else:
        real = os.path.realpath(sunshine)
        caps, _ = run(["getcap", real])
        ok = "cap_sys_admin" in caps
        results.append(check("kms-capability", "ok" if ok else "fail",
                             caps or f"{real} has no capabilities",
                             None if ok else f"sudo setcap cap_sys_admin+p {real}   (needed for KMS capture; redo after every Sunshine update)"))

        unit = main_unit()
        state = service_state(unit)
        results.append(check("sunshine-unit", "ok" if state == "active" else "warn", f"{unit}.service is {state}",
                             None if state == "active" else
                             f"systemctl --user enable --now {unit}   (or set sunshine_unit in {CONFIG_FILE})"))

    conf = read_conf(SUNSHINE_CONF)
    cap = conf.get("capture", "(auto)")
    results.append(check("capture-method", "ok" if cap == "kms" else "warn", f"capture = {cap}",
                         None if cap == "kms" else f"Set 'capture = kms' in {SUNSHINE_CONF} (wlroots capture stutters more on Hyprland)."))

    dead = [k for k in WINDOWS_ONLY_KEYS if k in conf]
    results.append(check("dead-settings", "warn" if dead else "ok",
                         ", ".join(f"{k}: {WINDOWS_ONLY_KEYS[k]}" for k in dead) or "none",
                         f"Remove {', '.join(dead)} from sunshine.conf." if dead else None))
    mft = conf.get("minimum_fps_target")
    if mft and mft.isdigit() and int(mft) < 30:
        results.append(check("minimum-fps", "warn", f"minimum_fps_target = {mft}",
                             "Remove it; a low floor lets the stream idle down and makes the mouse feel laggy."))

    if "omarchy-stream hook" not in conf.get("global_prep_cmd", ""):
        results.append(check("session-hooks", "warn", "Sunshine doesn't call omarchy-stream on connect/disconnect",
                             "Rerun ./install.sh (adds global_prep_cmd: VRR off while streaming, lock on disconnect)."))
    else:
        results.append(check("session-hooks", "ok", "VRR off while streaming, lock on disconnect (see ~/.config/omarchy-stream/config.json)"))

    enc = detect_encoder()
    if enc is None:
        results.append(check("encoder", "warn", "no encoder line in sunshine.log yet",
                             "Start a stream once, then rerun doctor."))
    else:
        sw = enc == ["software"]
        results.append(check("encoder", "fail" if sw else "ok", ", ".join(enc),
                             "Sunshine fell back to software encoding: check GPU drivers (nvidia-utils / libva) and 'encoder = nvenc|vaapi'." if sw else None))

    uinput = Path("/dev/uinput")
    can = uinput.exists() and os.access(uinput, os.W_OK)
    results.append(check("input", "ok" if can else "fail",
                         "/dev/uinput writable" if can else "/dev/uinput not writable: remote mouse/keyboard/gamepads won't work",
                         None if can else "Install Sunshine's udev rule (60-sunshine.rules), add yourself to the 'input' group, re-login."))

    out, code = run(["ip", "-j", "route", "show", "default"])
    if code == 0:
        try:
            routes = json.loads(out)
        except json.JSONDecodeError:
            routes = []
        metrics = [r.get("metric", 0) for r in routes]
        devs = [r.get("dev") for r in routes]
        if len(routes) > 1 and len(set(metrics)) < len(metrics):
            results.append(check("routing", "fail",
                                 f"{len(routes)} default routes with equal metric ({', '.join(devs)}) - a likely cause of Moonlight 'Error -1' disconnects",
                                 "Keep Wi-Fi on but make Ethernet preferred: nmcli connection modify <wifi-connection> ipv4.route-metric 600 ipv6.route-metric 600"))
        else:
            results.append(check("routing", "ok", ", ".join(f"{d} (metric {m})" for d, m in zip(devs, metrics, strict=True)) or "no default route"))

    data, peers = tailscale_peers()
    if data is None:
        results.append(check("tailscale", "warn", "tailscale not running", "sudo systemctl enable --now tailscaled && sudo tailscale up"))
    else:
        online = [p for p in peers if p["online"]]
        if not online:
            results.append(check("tailscale", "warn", "no peers online", "Connect the client (Mac) to your tailnet."))
        idle = [p for p in online if not p["active"]]
        if idle:
            results.append(check("tailscale-idle", "ok", f"{len(idle)} online peer(s) idle; their path is only known once traffic flows"))
        if online and len(idle) == len(online):
            results.append(check("tailscale-path", "warn", "no peer is talking to this host right now",
                                 "Start a stream (or tailscale ping this host) from the Mac, then rerun doctor."))
        for p in online:
            if not p["active"]:
                continue
            if p["direct"]:
                results.append(check(f"path:{p['name']}", "ok", f"direct via {p['endpoint']}"))
            else:
                results.append(check(f"path:{p['name']}", "fail",
                                     f"relayed through DERP '{p['relay']}' - caps bandwidth, adds latency, drops packets",
                                     f"From the client run: tailscale ping {p['ip']}. If it stays on DERP, enable UPnP on the host's router or forward UDP 41641 to this machine."))

    out, code = run(["nvidia-smi", "--query-gpu=name,driver_version", "--format=csv,noheader"])
    if code == 0 and out:
        results.append(check("gpu", "ok", out))
    results += remote_access_results()
    return results


AUTOLOGIN_DROPIN = Path(os.environ.get("AUTOLOGIN_DIR", "/etc/systemd/system/getty@tty1.service.d"))


def autologin_user():
    """The user TTY1 logs in as by itself, if any. Without one, a reboot leaves no session to stream."""
    try:
        files = sorted(AUTOLOGIN_DROPIN.glob("*.conf"))
    except OSError:
        return None
    for f in files:
        try:
            m = re.search(r"--autologin\s+(\S+)", f.read_text())
        except OSError:
            continue
        if m:
            return m.group(1)
    return None


def remote_access_results():
    """Can you still get in when the stream can't? Each answer here is another way back to this machine."""
    results = []
    me = os.environ.get("USER", "")

    state = (run(["systemctl", "is-active", "sshd"])[0] or "unknown").strip()
    results.append(check("ssh", "ok" if state == "active" else "fail", f"sshd is {state}",
                         None if state == "active" else
                         "sudo systemctl enable --now sshd   (your way in when Sunshine is down)"))

    prefs, _ = run(["tailscale", "debug", "prefs"])
    try:
        run_ssh = json.loads(prefs).get("RunSSH") is True
    except json.JSONDecodeError:
        run_ssh = False
    results.append(check("tailscale-ssh", "ok" if run_ssh else "warn",
                         "on: the Mac can SSH in without setting up a key" if run_ssh else
                         "off: SSH needs the Mac's key in ~/.ssh/authorized_keys",
                         None if run_ssh else
                         f"sudo tailscale up --ssh   (then 'tailscale ssh {me}@$(hostname)' works from the Mac)"))

    out, _ = run(["loginctl", "show-user", me, "-p", "Linger"])
    linger = "yes" in out.lower()
    results.append(check("linger", "ok" if linger else "warn",
                         "user services survive logout" if linger else "user services die with your session",
                         None if linger else f"loginctl enable-linger {me}"))

    awake = [t for t in ("sleep.target", "suspend.target", "hibernate.target")
             if (run(["systemctl", "is-enabled", t])[0] or "").strip() != "masked"]
    results.append(check("stays-awake", "ok" if not awake else "warn",
                         "sleep, suspend and hibernate are masked" if not awake else
                         f"can still sleep ({', '.join(awake)}), and a sleeping PC is unreachable",
                         None if not awake else "sudo systemctl mask sleep.target suspend.target hibernate.target"))

    for unit in ("omarchy-stream-dashboard", main_unit()):
        on = (run(["systemctl", "--user", "is-enabled", unit])[0] or "").strip() == "enabled"
        results.append(check(f"boots:{unit}", "ok" if on else "warn",
                             "starts on boot" if on else "does not start on boot",
                             None if on else f"systemctl --user enable {unit}"))

    vox, typer = shutil.which("voxtype"), shutil.which("wtype")
    if vox:
        whose = "this PC's" if dictate_mic() == "host" else "the Mac's"
        results.append(check("dictation", "ok" if typer else "warn",
                             f"Option+X while streaming, {whose} microphone"
                             + ("" if typer else "; no wtype, so the text only lands on the clipboard"),
                             None if typer else "yay -S wtype"))

    who = autologin_user()
    results.append(check("autologin", "ok" if who else "warn",
                         f"TTY1 logs in as {who}, so a reboot brings the desktop back" if who else
                         "none: after a reboot the PC waits at a login prompt, with no desktop to stream",
                         None if who else
                         "A reboot needs someone to log in at the machine. TTY1 autologin fixes that, but then "
                         "anyone sitting at this PC gets your desktop: only do it if the PC stands somewhere you trust."))
    return results


def hypr_up():
    hypr = Path(f"/run/user/{os.getuid()}/hypr")
    try:
        return hypr.is_dir() and any(hypr.iterdir())
    except OSError:
        return False


def rescue_streams():
    """Clear out stuck instances and restart the main Sunshine. Leaves the dashboard alone."""
    for n in instance_names():
        if service_state(f"sunshine@{n}") == "active":
            run(["systemctl", "--user", "stop", f"sunshine@{n}"], timeout=30)
    run(["systemctl", "--user", "restart", main_unit()], timeout=30)
    return {"unit": main_unit(), "state": service_state(main_unit()), "hyprland": hypr_up()}


def cmd_rescue(_args):
    """Put the pieces back with no desktop involved: what the Mac runs over SSH when a stream won't start."""
    info = rescue_streams()
    run(["systemctl", "--user", "restart", "omarchy-stream-dashboard"], timeout=30)
    print(f"dashboard: {service_state('omarchy-stream-dashboard')}")
    print(f"{info['unit']}: {info['state']}")
    print("hyprland: up" if info["hyprland"] else
          "hyprland: DOWN - nothing to stream until someone logs in at the machine")
    return 0


def cmd_doctor(args):
    results = cmd_doctor_results()
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        icon = {"ok": "\033[32m✔\033[0m", "warn": "\033[33m!\033[0m", "fail": "\033[31m✘\033[0m"}
        for r in results:
            print(f"{icon[r['status']]} {r['check']:<22} {r['detail']}")
            if r["fix"]:
                print(f"    fix: {r['fix']}")
    return 1 if any(r["status"] == "fail" for r in results) else 0


# --------------------------------------------------------------------------- multi-instance

def instance_names():
    if not INSTANCES_DIR.is_dir():
        return []
    confs = [p for p in INSTANCES_DIR.iterdir() if (p / "sunshine.conf").is_file()]
    # Port order = left-to-right monitor order from `multi setup`.
    return [p.name for p in sorted(confs, key=lambda p: int(read_conf(p / "sunshine.conf").get("port", 0)))]


def kms_indexes(names):
    """Sunshine's KMS output_name is an index in CRTC order, which follows DRM connector ids
    (verified on an RTX 3070: DP-1 823, HDMI-A-2 834, DP-3 837 -> 0, 1, 2), not screen position."""
    root = Path(os.environ.get("DRM_SYSFS", "/sys/class/drm"))
    ids = {}
    for n in names:
        for f in root.glob(f"card*-{n}/connector_id"):
            try:
                ids[n] = int(f.read_text())
            except (OSError, ValueError):
                pass
    if len(ids) != len(names):
        return {n: i for i, n in enumerate(names)}  # fallback: left-to-right
    return {n: i for i, n in enumerate(sorted(names, key=ids.get))}


def cmd_multi(args):
    if args.action == "setup":
        mons = [x for x in hypr_monitors() if x["name"] != VIRTUAL_NAME]
        if not mons:
            print("No monitors from hyprctl.")
            return 1
        base = read_conf(SUNSHINE_CONF)
        keep = {k: v for k, v in base.items()
                if k not in WINDOWS_ONLY_KEYS and k not in
                {"port", "output_name", "sunshine_name", "minimum_fps_target", "file_state", "credentials_file",
                 "log_path", "file_apps", "pkey", "cert"}}
        keep.setdefault("capture", "kms")
        keep["min_log_level"] = "info"  # verbose logs every input packet
        host = os.uname().nodename
        kms = kms_indexes([m["name"] for m in mons])
        for i, m in enumerate(mons):
            d = INSTANCES_DIR / m["name"]
            d.mkdir(parents=True, exist_ok=True)
            conf = dict(keep)
            conf.update({
                "sunshine_name": f"{host}-{m['name']}",
                "port": str(BASE_PORT + PORT_STEP * (i + 1)),
                # KMS capture selects monitors by index in DRM connector order.
                "output_name": str(kms[m["name"]]),
                "file_state": str(d / "sunshine_state.json"),
                "credentials_file": str(d / "sunshine_state.json"),
                "file_apps": str(d / "apps.json"),
                "log_path": str(d / "sunshine.log"),
                "pkey": str(d / "credentials/cakey.pem"),
                "cert": str(d / "credentials/cacert.pem"),
            })
            target = d / "sunshine.conf"
            if target.exists():
                shutil.copy2(target, target.with_suffix(f".conf.bak.{int(time.time())}"))
            target.write_text("".join(f"{k} = {v}\n" for k, v in conf.items()))
            if not (d / "apps.json").exists():
                (d / "apps.json").write_text(json.dumps({"env": {}, "apps": [{"name": "Desktop", "image-path": "desktop.png"}]}, indent=2))
            ensure_webcreds(d)
            print(f"{m['name']:<10} port {conf['port']}  output_name {conf['output_name']}  -> {target}")
        print("\nCheck the 'Monitor N is ...' lines in each instance log after 'multi up';"
              " if a monitor index doesn't match, edit output_name in that instance's sunshine.conf."
              "\nEach instance pairs separately (web UI at https://localhost:<port+1>).")
        return 0

    names = [n for n in instance_names() if n != "virtual"]
    if not names:
        print("No instances. Run: omarchy-stream multi setup")
        return 1
    verb = {"up": "start", "down": "stop"}[args.action]
    if args.action == "up":
        run(["systemctl", "--user", "stop", main_unit()])  # single-stream instance would grab the default ports
    rc = 0
    for n in names:
        if args.action == "up":
            ensure_webcreds(INSTANCES_DIR / n)
        _, code = run(["systemctl", "--user", verb, f"sunshine@{n}"], timeout=20)
        print(f"{verb} sunshine@{n}: {'ok' if code == 0 else 'failed'}")
        rc |= code
    if args.action == "down":
        _, code = run(["systemctl", "--user", "start", main_unit()], timeout=20)
        print(f"start {main_unit()}: {'ok' if code == 0 else 'failed'}")
    return 1 if rc else 0


# --------------------------------------------------------------------------- pairing

def ensure_webcreds(d):
    """Give an instance its own web-UI login so pairing PINs can be submitted for it."""
    f = d / "webcreds"
    if f.exists():
        return True
    pw = secrets.token_urlsafe(18)
    # `--creds` writes the login into the instance's state file and exits; pairings are kept.
    _, code = run([sunshine_bin(), str(d / "sunshine.conf"), "--creds", "omarchy", pw], timeout=30)
    if code != 0:
        return False
    f.write_text(pw)
    f.chmod(0o600)
    return True


def instance_by_port(port):
    for n in instance_names():
        if read_conf(INSTANCES_DIR / n / "sunshine.conf").get("port") == str(port):
            return n
    return None


def sunshine_api(port, method, path, pw, body=None):
    scheme = os.environ.get("OMARCHY_SUNSHINE_SCHEME", "https")
    req = urllib.request.Request(f"{scheme}://127.0.0.1:{port}{path}", method=method,
                                 data=json.dumps(body).encode() if body is not None else None)
    req.add_header("Authorization", "Basic " + base64.b64encode(f"omarchy:{pw}".encode()).decode())
    if body is not None:
        req.add_header("Content-Type", "application/json")
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE  # Sunshine's own self-signed cert on localhost
    with urllib.request.urlopen(req, timeout=5, context=ctx) as r:
        return json.loads(r.read() or b"{}")


def pair_instance(port, pin, device="Mac", wait=20):
    """Submit a PIN for the pairing request a Moonlight client just started against an instance."""
    name = instance_by_port(port)
    if not name:
        return False, f"no instance on port {port}"
    d = INSTANCES_DIR / name
    if not ensure_webcreds(d):
        return False, "could not set web credentials for this instance"
    pw = (d / "webcreds").read_text().strip()
    web = int(port) + 1
    deadline = time.time() + wait
    while True:
        try:
            pending = sunshine_api(web, "GET", "/api/pin", pw).get("pairings") or []
        except (OSError, ValueError) as e:
            pending, err = [], str(e)
        else:
            err = "no pairing request arrived"
        if pending:
            res = sunshine_api(web, "POST", "/api/pin", pw,
                               {"pairing_id": pending[-1]["id"], "pin": pin, "name": device})
            return bool(res.get("status")), res.get("error") or "paired"
        if time.time() > deadline:
            return False, err
        time.sleep(0.5)


# --------------------------------------------------------------------------- session hooks

VIRTUAL_NAME = "OS-VIRTUAL"
VIRTUAL_PORT = BASE_PORT + PORT_STEP * 10


def ensure_hypr_env():
    """Sunshine runs hooks from a systemd user service, which may lack
    HYPRLAND_INSTANCE_SIGNATURE. Recover it from the runtime socket dir."""
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr"
    socks = sorted(runtime.glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not socks:
        return False
    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = socks[0].parent.name
    os.environ.setdefault("XDG_RUNTIME_DIR", str(runtime.parent))
    return True


def hypr_option(name):
    out, code = run(["hyprctl", "getoption", name, "-j"])
    if code != 0:
        return None
    try:
        d = json.loads(out)
    except json.JSONDecodeError:
        return None
    return d["bool"] if "bool" in d else d.get("int")


def set_hypr_option(name, value):
    """`keyword` on legacy configs; `eval` on Lua configs (Hyprland 0.5x+), which reject `keyword`."""
    text = str(value).lower() if isinstance(value, bool) else str(value)
    out, code = run(["hyprctl", "keyword", name, text])
    if code != 0 or "eval" in out:
        section, key = name.split(":", 1)
        run(["hyprctl", "eval", f"hl.config({{ {section} = {{ {key} = {text} }} }})"])


STREAM_KEYS = [(f"CTRL + ALT + {n}", f'hl.dsp.focus({{ workspace = "{n}", on_current_monitor = true }})',
                f"CTRL ALT,{n},focusworkspaceoncurrentmonitor,{n}") for n in range(1, 6)]


def stream_keys(on):
    """Bindings that only exist while a stream is up. Lua configs take `eval`; legacy ones `keyword`."""
    me = APP_DIR / "omarchy-stream"
    keys = STREAM_KEYS + [("CTRL + ALT + Q", f'hl.dsp.exec_cmd("{me} disconnect")', f"CTRL ALT,Q,exec,{me} disconnect")]
    # Option+X: hold to dictate, like the local Option+X (which is MOD5 there, plain Alt through
    # Moonlight). Which microphone listens is a setting; `dictate` handles both.
    if shutil.which("voxtype"):
        keys += [("ALT + X", f'hl.dsp.exec_cmd("{me} dictate start")', f"ALT,X,exec,{me} dictate start"),
                 ("ALT + X", f'hl.dsp.exec_cmd("{me} dictate stop")', f"ALT,X,exec,{me} dictate stop", "release")]
    for lua_keys, lua_dsp, legacy, *release in keys:
        if on:
            opts = "description = \"omarchy-stream\"" + (", release = true" if release else "")
            out, code = run(["hyprctl", "eval", f'hl.bind("{lua_keys}", {lua_dsp}, {{ {opts} }})'])
            if code != 0 or out.strip() != "ok":
                run(["hyprctl", "keyword", "bindr" if release else "bind", legacy])
        else:
            if release:
                continue  # the press entry's unbind removes both
            out, code = run(["hyprctl", "eval", f'hl.unbind("{lua_keys}")'])
            if code != 0 or out.strip() != "ok":
                run(["hyprctl", "keyword", "unbind", ",".join(legacy.split(",")[:2])])


def cmd_disconnect(_args):
    """End every running stream: instances via their Sunshine API, the main unit by restarting it."""
    closed = False
    for n in instance_names():
        if service_state(f"sunshine@{n}") != "active":
            continue
        closed = True
        d = INSTANCES_DIR / n
        try:
            pw = (d / "webcreds").read_text().strip()
            sunshine_api(int(read_conf(d / "sunshine.conf").get("port", 0)) + 1, "POST", "/api/apps/close", pw, {})
        except (OSError, ValueError):
            run(["systemctl", "--user", "restart", f"sunshine@{n}"], timeout=20)
    if not closed and service_state(main_unit()) == "active":
        run(["systemctl", "--user", "restart", main_unit()], timeout=20)
    return 0


AUDIO_PREF = STATE_DIR / "audio.pref"


def cmd_audio_apply(_args):
    """With sound on the host, Sunshine still records the speakers and streams them to the client:
    you'd hear everything twice. Mute Sunshine's recording stream instead (host speakers untouched)."""
    want_mute = AUDIO_PREF.exists() and AUDIO_PREF.read_text().strip() == "host"
    done, deadline = set(), time.time() + 20 * SETTLE
    while time.time() < deadline:
        out, code = run(["pactl", "-f", "json", "list", "source-outputs"])
        try:
            streams = json.loads(out) if code == 0 else []
        except json.JSONDecodeError:
            streams = []
        for st in streams:
            if (st.get("properties") or {}).get("application.name") == "sunshine" and st["index"] not in done:
                run(["pactl", "set-source-output-mute", str(st["index"]), "1" if want_mute else "0"])
                done.add(st["index"])
        if done and time.time() > deadline - 15 * SETTLE:
            break  # found it; a few extra seconds covered late streams
        time.sleep(0.25)
    return 0


# --------------------------------------------------------------------------- dictation

DICTATE_MIC = STATE_DIR / "dictate.mic"       # host (this PC's mic) or mac
DICTATE_STATE = STATE_DIR / "dictate.state"   # idle or rec, watched by the Mac over a long poll
DICTATE_LOG = STATE_DIR / "dictate.log"


def dictate_mic():
    try:
        return "mac" if DICTATE_MIC.read_text().strip() == "mac" else "host"
    except OSError:
        return "host"


def dictate_log(line):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(DICTATE_LOG, "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} {line}\n")


def set_dictate_state(value):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    DICTATE_STATE.write_text(value)


def cmd_dictate(args):
    """Option+X while streaming. With the PC's mic, voxtype does it all; with the Mac's, this only
    flips a flag the Mac is watching, and the audio comes back to /api/dictate."""
    if dictate_mic() == "host":
        run(["voxtype", "record", args.action], timeout=10)
        return 0
    set_dictate_state("rec" if args.action == "start" else "idle")
    dictate_log(f"mac mic: {args.action}")
    return 0


def transcribe_and_type(wav):
    """voxtype prints the model's chatter on stdout and the text on its INFO line on stderr,
    so both streams are read here."""
    try:
        p = subprocess.run(["voxtype", "transcribe", str(wav)], capture_output=True, text=True, timeout=180)
        out, code = (p.stdout or "") + (p.stderr or ""), p.returncode
    except (OSError, subprocess.TimeoutExpired) as e:
        out, code = str(e), 127
    if code != 0:
        dictate_log(f"transcribe failed rc={code}")
        return ""
    m = re.search(r'Transcription completed in [\d.]+s: "(.*)"', out)
    if m:
        text = m.group(1)
    else:   # older voxtype: just the text, with the model's loading chatter around it
        noise = ("Loading", "Audio format", "Processing", "whisper", "ggml", "voxtype")
        lines = [ln.strip() for ln in out.splitlines()
                 if ln.strip() and not ln.startswith(noise) and " INFO" not in ln and " WARN" not in ln]
        text = lines[-1] if lines else ""
    text = text.strip()
    if not text:
        dictate_log("nothing recognised")
        return ""
    if shutil.which("wtype"):
        _, code = run(["wtype", "--", text], timeout=30)
    else:
        _, code = (run(["wl-copy", "--", text], timeout=10))  # no wtype: at least leave it on the clipboard
    dictate_log(f"typed {len(text)} chars rc={code}: {text[:60]}")
    return text


def lock_session():
    """Omarchy locks via omarchy-system-lock (omarchy-shell); hypridle may not be running to
    act on logind's Lock signal. From a service, name the graphical session explicitly."""
    if shutil.which("omarchy-system-lock"):
        _, code = run(["omarchy-system-lock"], timeout=15)
        if code == 0:
            return
    sid, _ = run(["loginctl", "show-user", str(os.getuid()), "-p", "Display", "--value"])
    run(["loginctl", "lock-session"] + ([sid] if sid else []))


def cmd_hook(args):
    """Called by Sunshine's global_prep_cmd on every stream start/stop."""
    cfg = load_config()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not ensure_hypr_env():
        print("hook: Hyprland not found; nothing to do", file=sys.stderr)
        return 0  # never block a stream because of a hook
    if args.event == "connect":
        state = {"started": time.time()}
        if cfg["disable_vrr_while_streaming"]:
            vrr = hypr_option("misc:vrr")
            if vrr:
                state["vrr"] = vrr
                set_hypr_option("misc:vrr", 0)
        if cfg["hide_host_cursor_while_streaming"] and hypr_option("cursor:invisible") is False:
            state["cursor_hidden"] = True
            set_hypr_option("cursor:invisible", True)
        if cfg["stream_keys"]:
            stream_keys(True)
            state["keys"] = True
        set_dictate_state("idle")   # a stuck "rec" from a dropped session would record forever
        # Sunshine opens its recording stream just after this hook; mute/unmute it in the background.
        subprocess.Popen([str(APP_DIR / "omarchy-stream"), "audio-apply"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        SESSION_FILE.write_text(json.dumps(state))
        return 0
    try:
        state = json.loads(SESSION_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        state = {}
    if state.get("vrr"):
        set_hypr_option("misc:vrr", state["vrr"])
    if state.get("cursor_hidden"):
        set_hypr_option("cursor:invisible", False)
    if state.get("keys"):
        stream_keys(False)
    set_dictate_state("idle")
    SESSION_FILE.unlink(missing_ok=True)
    if cfg["lock_on_disconnect"]:
        lock_session()
    return 0


# --------------------------------------------------------------------------- virtual display

HYPR_RULE_LUA = HOME / ".config/hypr/omarchy-stream.lua"
HYPR_RULE_CONF = HOME / ".config/hypr/omarchy-stream.conf"


def write_virtual_rule(w, h, hz, scale):
    HYPR_RULE_LUA.parent.mkdir(parents=True, exist_ok=True)
    HYPR_RULE_LUA.write_text("-- written by omarchy-stream (virtual display size)\n"
                             f'hl.monitor({{ output = "{VIRTUAL_NAME}", mode = "{w}x{h}@{hz}", position = "auto", scale = {scale} }})\n')
    HYPR_RULE_CONF.write_text(f"# written by omarchy-stream (virtual display size)\nmonitor = {VIRTUAL_NAME},{w}x{h}@{hz},auto,{scale}\n")


def hypr_events():
    """Connect to Hyprland's event socket now, so events that follow aren't missed."""
    import socket
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    path = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr" / sig / ".socket2.sock"
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(str(path))
        return s
    except OSError:
        return None


def wait_event(sock, name, timeout):
    if sock is None:
        time.sleep(timeout)
        return False
    deadline, buf = time.time() + timeout, b""
    try:
        while time.time() < deadline:
            sock.settimeout(max(0.05, deadline - time.time()))
            try:
                chunk = sock.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            if any(line.startswith(name.encode()) for line in buf.split(b"\n")):
                return True
        return False
    finally:
        sock.close()


def wait_port(port, timeout):
    import socket
    deadline = time.time() + timeout
    while time.time() < deadline:
        with socket.socket() as s:
            s.settimeout(0.2)
            if s.connect_ex(("127.0.0.1", port)) == 0:
                return True
        time.sleep(0.1)
    return False


def set_output_mode(name, w, h, hz, scale):
    """Hyprland with a Lua config (0.5x+) rejects `keyword` and wants `eval`; older ones lack `eval`.
    Values are regex-validated digits, so the Lua string can't be injected into."""
    lua = f'hl.monitor({{ output = "{name}", mode = "{w}x{h}@{hz}", position = "auto", scale = {scale} }})'
    for _ in range(4):
        out, code = run(["hyprctl", "keyword", "monitor", f"{name},{w}x{h}@{hz},auto,{scale}"])
        if code != 0 or "eval" in out:
            run(["hyprctl", "eval", lua])
        deadline = time.time() + SETTLE
        while True:
            m = next((x for x in hypr_monitors() if x["name"] == name), None)
            if m and (m["width"], m["height"]) == (int(w), int(h)):
                return True
            if time.time() >= deadline:
                break
            time.sleep(0.1)
    return False


LAYOUT_FILE = STATE_DIR / "layout.json"


def save_layout():
    """Which workspace each physical monitor shows, so switching on the virtual screen can be undone."""
    if LAYOUT_FILE.exists():
        return
    layout = {m["name"]: str((m.get("activeWorkspace") or {}).get("id", ""))
              for m in hypr_monitors() if m["name"] != VIRTUAL_NAME}
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAYOUT_FILE.write_text(json.dumps(layout))


def restore_layout():
    try:
        layout = json.loads(LAYOUT_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return
    want = {mon: ws for mon, ws in layout.items() if ws and not ws.startswith("-")}
    for _ in range(3):
        for mon, ws in want.items():
            run(["hyprctl", "eval", f'hl.dispatch(hl.dsp.focus({{ monitor = "{mon}" }}))'])
            run(["hyprctl", "eval", f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}", on_current_monitor = true }}))'])
        time.sleep(0.3 * SETTLE)
        now = {m["name"]: str((m.get("activeWorkspace") or {}).get("id", "")) for m in hypr_monitors()}
        if all(now.get(mon) == ws for mon, ws in want.items()):
            break
    LAYOUT_FILE.unlink(missing_ok=True)


def cmd_virtual(args):
    """Parsec-style virtual display: a headless Hyprland output sized to the client."""
    d = INSTANCES_DIR / "virtual"
    ensure_hypr_env()
    if args.spec == "off":
        # Sunshine runs the disconnect hook a few seconds after the client leaves; stopping the
        # instance first would kill it mid-way (VRR/keys not restored, no lock). Wait for it.
        deadline = time.time() + 10 * SETTLE
        while SESSION_FILE.exists() and time.time() < deadline:
            time.sleep(0.25)
        run(["systemctl", "--user", "stop", "sunshine@virtual"], timeout=20)
        events = hypr_events()
        run(["hyprctl", "output", "remove", VIRTUAL_NAME])
        wait_event(events, "configreloaded", 2.5 * SETTLE)  # workspaces migrate, watchers reload; then restore
        restore_layout()
        print("virtual display removed")
        return 0
    m = re.fullmatch(r"(\d{3,5})x(\d{3,5})(?:@(\d{2,3}))?(?:,([\d.]+))?", args.spec)
    if not m:
        print("usage: omarchy-stream virtual WIDTHxHEIGHT[@HZ][,SCALE] | off   e.g. 3024x1964@60,2")
        return 2
    w, h, hz, scale = m.group(1), m.group(2), m.group(3) or "60", m.group(4) or "1"
    # The size rule must live in the config: monitor watchers `hyprctl reload` on every change,
    # which drops runtime rules. install.sh makes hyprland.lua/.conf include this file.
    write_virtual_rule(w, h, hz, scale)
    run(["hyprctl", "reload"])
    if not any(x["name"] == VIRTUAL_NAME for x in hypr_monitors()):
        save_layout()
        events = hypr_events()
        _, code = run(["hyprctl", "output", "create", "headless", VIRTUAL_NAME])
        if code != 0:
            print("hyprctl could not create a headless output (needs Hyprland >= 0.41)")
            return 1
        # Hotplug scripts may `hyprctl reload` ~1 s after an output appears, which resets its mode.
        wait_event(events, "configreloaded", 1.8 * SETTLE)
    if not set_output_mode(VIRTUAL_NAME, w, h, hz, scale):
        print(f"warning: {VIRTUAL_NAME} did not take mode {w}x{h}; check `hyprctl monitors`")
    time.sleep(0.3 * SETTLE)  # a late reload would reset it; check once more
    set_output_mode(VIRTUAL_NAME, w, h, hz, scale)
    d.mkdir(parents=True, exist_ok=True)
    base = {k: v for k, v in read_conf(SUNSHINE_CONF).items()
            if k not in WINDOWS_ONLY_KEYS and k != "minimum_fps_target"}
    base.update({
        "sunshine_name": f"{os.uname().nodename}-virtual",
        "port": str(VIRTUAL_PORT),
        # KMS only sees physical connectors; a headless output needs wlroots capture.
        "capture": "wlr",
        "output_name": VIRTUAL_NAME,
        "min_log_level": "info",  # verbose logs every input packet
        "file_state": str(d / "sunshine_state.json"),
        "credentials_file": str(d / "sunshine_state.json"),
        "file_apps": str(d / "apps.json"),
        "log_path": str(d / "sunshine.log"),
        "pkey": str(d / "credentials/cakey.pem"),
        "cert": str(d / "credentials/cacert.pem"),
    })
    (d / "sunshine.conf").write_text("".join(f"{k} = {v}\n" for k, v in base.items()))
    if not (d / "apps.json").exists():
        (d / "apps.json").write_text(json.dumps({"env": {}, "apps": [{"name": "Desktop"}]}, indent=2))
    ensure_webcreds(d)
    # Start on the main workspace instead of an empty desktop (Ctrl+Alt+1..5 switch while streaming).
    run(["hyprctl", "eval", f'hl.dispatch(hl.dsp.focus({{ monitor = "{VIRTUAL_NAME}" }}))'])
    run(["hyprctl", "eval", 'hl.dispatch(hl.dsp.focus({ workspace = "1", on_current_monitor = true }))'])
    _, code = run(["systemctl", "--user", "restart", "sunshine@virtual"], timeout=20)
    wait_port(VIRTUAL_PORT, 8 * SETTLE)  # return as soon as Moonlight can connect
    print(f"virtual display {w}x{h}@{hz} scale {scale} on port {VIRTUAL_PORT}"
          f" ({'running' if code == 0 else 'failed to start sunshine@virtual'})")
    print(f"Move a workspace onto it: hyprctl dispatch moveworkspacetomonitor <n> {VIRTUAL_NAME}")
    return 0 if code == 0 else 1


