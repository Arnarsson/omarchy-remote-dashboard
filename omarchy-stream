# --------------------------------------------------------------------------- clipboard sync

CLIP_MAX = 25 * 1024 * 1024


def clipboard_get():
    """Current clipboard as (bytes, content type): a picture if that's all there is, else text."""
    types, _ = run(["wl-paste", "--list-types"])
    types = types.splitlines()
    has_text = any(t.startswith("text/plain") or t in ("TEXT", "STRING", "UTF8_STRING") for t in types)
    try:
        if "image/png" in types and not has_text:
            r = subprocess.run(["wl-paste", "--type", "image/png"], capture_output=True, timeout=5)
            return r.stdout, "image/png"
        if has_text:
            r = subprocess.run(["wl-paste", "--no-newline", "--type", "text"], capture_output=True, timeout=5)
            return r.stdout, "text/plain; charset=utf-8"
    except (OSError, subprocess.TimeoutExpired):
        pass
    return b"", ""


def clip_log(msg):
    try:
        f = STATE_DIR / "clipboard.log"
        lines = (f.read_text().splitlines()[-300:] if f.exists() else []) + [f"{time.strftime('%H:%M:%S')} {msg}"]
        f.write_text("\n".join(lines) + "\n")
    except OSError:
        pass


def clipboard_set(data, ctype):
    kind = "image/png" if ctype.startswith("image/png") else "text/plain;charset=utf-8"
    try:
        # wl-copy forks to serve the clipboard; don't hold its pipes open.
        subprocess.run(["wl-copy", "--type", kind], input=data, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
        return True
    except (OSError, subprocess.TimeoutExpired):
        return False


def make_handler(token):
    index = (APP_DIR / "dashboard/index.html").read_bytes()
    allowed_units = lambda: {main_unit()} | {f"sunshine@{n}" for n in instance_names()}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, body, ctype="application/json"):
            if not isinstance(body, bytes):
                body = json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def authed(self):
            got = self.headers.get("Authorization", "").removeprefix("Bearer ").strip()
            return hmac.compare_digest(got, token)

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                return self.send(200, index, "text/html; charset=utf-8")
            if self.path == "/api/ping":
                return self.send(200, {"ok": True})
            if not self.authed():
                return self.send(401, {"error": "token required"})
            if self.path == "/api/status":
                return self.send(200, status())
            if self.path == "/api/doctor":
                return self.send(200, cmd_doctor_results())
            if self.path == "/api/path":  # direct or relayed, for the client asking (instant, no CLI on the Mac)
                _, peers = tailscale_peers()
                me = next((x for x in peers if x["ip"] == self.client_address[0]), None)
                return self.send(200, {"known": bool(me), "direct": bool(me and me["direct"]),
                                       "relay": me and me["relay"], "endpoint": me and me["endpoint"]})
            if self.path.startswith("/api/clipboard"):
                from urllib.parse import parse_qs, urlparse
                have = (parse_qs(urlparse(self.path).query).get("have") or [""])[0]
                data, ctype = clipboard_get()
                if not data:
                    return self.send(204, b"", "text/plain")
                digest = hashlib.sha1(data).hexdigest()
                if digest == have:
                    return self.send(304, b"", "text/plain")
                clip_log(f"Linux->Mac {ctype} {len(data)} bytes")
                return self.send(200, data, ctype)
            if self.path.startswith("/api/dictate"):
                # Long poll: the Mac holds this open and learns the moment Option+X goes down,
                # so recording starts with no polling chatter and no delay.
                from urllib.parse import parse_qs, urlparse
                have = (parse_qs(urlparse(self.path).query).get("have") or [""])[0]
                deadline = time.time() + 25
                while True:
                    try:
                        now = DICTATE_STATE.read_text().strip() or "idle"
                    except OSError:
                        now = "idle"
                    if now != have or time.time() > deadline:
                        return self.send(200, {"state": now, "mic": dictate_mic()})
                    time.sleep(0.05)
            if self.path == "/mac/omarchy-connect":  # the app self-updates from here
                return self.send(200, (APP_DIR / "mac/omarchy-connect").read_bytes(), "text/x-shellscript")
            if self.path == "/mac/app/omarchy-remote":
                return self.send(200, (APP_DIR / "mac/app/omarchy-remote").read_bytes(), "text/x-shellscript")
            if self.path == "/mac/setup":
                port = self.server.server_address[1]
                return self.send(200, mac_setup_script(token, port).encode(), "text/x-shellscript")
            self.send(404, {"error": "not found"})

        def do_POST(self):
            if not self.authed():
                return self.send(401, {"error": "token required"})
            m = re.fullmatch(r"/api/stream/([\w@.-]+)/(start|stop|restart)", self.path)
            if m:
                unit, action = m.groups()
                if unit not in allowed_units():
                    return self.send(400, {"error": f"unknown stream {unit}"})
                main = main_unit()
                if action == "start" and unit == main:
                    for n in instance_names():
                        run(["systemctl", "--user", "stop", f"sunshine@{n}"])
                if action == "start" and unit != main:
                    run(["systemctl", "--user", "stop", main])
                _, code = run(["systemctl", "--user", action, unit], timeout=20)
                return self.send(200 if code == 0 else 500, {"ok": code == 0, "unit": unit, "action": action})
            m = re.fullmatch(r"/api/virtual/(off|\d{3,5}x\d{3,5}(?:@\d{2,3})?(?:,[\d.]+)?)", self.path)
            if m:
                import io
                from contextlib import redirect_stdout
                buf = io.StringIO()
                with redirect_stdout(buf):
                    code = cmd_virtual(argparse.Namespace(spec=m.group(1)))
                return self.send(200 if code == 0 else 500, {"ok": code == 0, "message": buf.getvalue().strip(),
                                                              "port": VIRTUAL_PORT})
            if self.path == "/api/clipboard":
                n = int(self.headers.get("Content-Length") or 0)
                if n <= 0 or n > CLIP_MAX:
                    return self.send(413 if n > CLIP_MAX else 400, {"error": "bad size"})
                ctype = self.headers.get("Content-Type", "text/plain")
                ok = clipboard_set(self.rfile.read(n), ctype)
                clip_log(f"Mac->Linux {ctype} {n} bytes {'ok' if ok else 'FAILED'}")
                return self.send(200 if ok else 500, {"ok": ok})
            m = re.fullmatch(r"/api/dictate/mic/(host|mac)", self.path)
            if m:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                DICTATE_MIC.write_text(m.group(1))
                set_dictate_state("idle")
                return self.send(200, {"ok": True, "mic": m.group(1)})
            if self.path == "/api/dictate":  # the Mac's recording of what you just said
                n = int(self.headers.get("Content-Length") or 0)
                if n <= 0 or n > 16 * 1024 * 1024:
                    return self.send(400, {"error": "bad size"})
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                wav = STATE_DIR / "dictate.wav"
                wav.write_bytes(self.rfile.read(n))
                dictate_log(f"Mac mic: {n} bytes")
                text = transcribe_and_type(wav)
                return self.send(200, {"ok": bool(text), "text": text})
            if self.path == "/api/rescue":  # the Mac's "Fix connection": restart Sunshine, keep this server up
                info = rescue_streams()
                return self.send(200, {"ok": info["state"] == "active", **info})
            if self.path == "/api/report":  # Mac diagnostics, so problems can be read here
                n = min(int(self.headers.get("Content-Length") or 0), 16384)
                text = self.rfile.read(n).decode(errors="replace")
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                with open(STATE_DIR / "client-report.log", "a") as f:
                    f.write(f"=== {time.strftime('%Y-%m-%d %H:%M:%S')} from {self.client_address[0]}\n{text}\n")
                return self.send(200, {"ok": True})
            m = re.fullmatch(r"/api/audio/(host|mac)", self.path)
            if m:  # where the client wants sound for the next session
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                AUDIO_PREF.write_text(m.group(1))
                return self.send(200, {"ok": True, "audio": m.group(1)})
            m = re.fullmatch(r"/api/pair/(\d{4,5})/(\d{4})", self.path)
            if m:
                ok, msg = pair_instance(int(m.group(1)), m.group(2))
                return self.send(200 if ok else 500, {"ok": ok, "message": msg})
            m = re.fullmatch(r"/api/multi/(up|down)", self.path)
            if m:
                import io
                from contextlib import redirect_stdout
                buf = io.StringIO()
                with redirect_stdout(buf):
                    if m.group(1) == "up" and not [n for n in instance_names() if n != "virtual"]:
                        cmd_multi(argparse.Namespace(action="setup"))
                    code = cmd_multi(argparse.Namespace(action=m.group(1)))
                return self.send(200 if code == 0 else 500, {"ok": code == 0, "message": buf.getvalue().strip()})
            m = re.fullmatch(r"/api/workspace/(\d|next|prev)", self.path)
            if m:
                w = {"next": "+1", "prev": "-1"}.get(m.group(1), m.group(1))
                _, code = run(["hyprctl", "dispatch", "workspace", w])
                return self.send(200 if code == 0 else 500, {"ok": code == 0})
            self.send(404, {"error": "not found"})

    return H


def cmd_serve(args):
    ensure_hypr_env()  # the dashboard runs as a user service
    token = load_token()
    port = args.port or int(load_config()["dashboard_port"])
    binds = ["127.0.0.1"]
    if not args.local_only:
        data, _ = tailscale_peers()
        ip = data and ((data.get("Self") or {}).get("TailscaleIPs") or [None])[0]
        if ip:
            binds.append(ip)
        else:
            print("Tailscale IP not found; serving on localhost only.", file=sys.stderr)
    import threading
    servers = [ThreadingHTTPServer((b, port), make_handler(token)) for b in binds]
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    print(f"Dashboard on {', '.join(f'http://{b}:{port}' for b in binds)}")
    print(f"Token: {TOKEN_FILE}")
    servers[0].serve_forever()


def mac_oneliner():
    cfg = load_config()
    data, _ = tailscale_peers()
    ip = data and ((data.get("Self") or {}).get("TailscaleIPs") or [None])[0]
    return (f'curl -fsSL -H "Authorization: Bearer {load_token()}" '
            f'http://{ip or os.uname().nodename}:{cfg["dashboard_port"]}/mac/setup | bash')


def cmd_mac(_args):
    print("Run this once in Terminal on the Mac (Tailscale must be connected):\n")
    print("  " + mac_oneliner())
    return 0


def main():
    p = argparse.ArgumentParser(prog="omarchy-stream", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("doctor"); d.add_argument("--json", action="store_true"); d.set_defaults(fn=cmd_doctor)
    sub.add_parser("monitors").set_defaults(fn=cmd_monitors)
    m = sub.add_parser("multi"); m.add_argument("action", choices=["setup", "up", "down"]); m.set_defaults(fn=cmd_multi)
    h = sub.add_parser("hook"); h.add_argument("event", choices=["connect", "disconnect"]); h.set_defaults(fn=cmd_hook)
    v = sub.add_parser("virtual"); v.add_argument("spec"); v.set_defaults(fn=cmd_virtual)
    sub.add_parser("mac", help="print the one-line Mac setup command").set_defaults(fn=cmd_mac)
    sub.add_parser("rescue", help="restart the dashboard and Sunshine; safe to run over SSH").set_defaults(fn=cmd_rescue)
    di = sub.add_parser("dictate", help=argparse.SUPPRESS)
    di.add_argument("action", choices=["start", "stop"]); di.set_defaults(fn=cmd_dictate)
    sub.add_parser("disconnect", help="end all running streams").set_defaults(fn=cmd_disconnect)
    sub.add_parser("audio-apply", help=argparse.SUPPRESS).set_defaults(fn=cmd_audio_apply)
    s = sub.add_parser("serve"); s.add_argument("--port", type=int, help="default: dashboard_port in config.json (8080)")
    s.add_argument("--local-only", action="store_true"); s.set_defaults(fn=cmd_serve)
    a = p.parse_args()
    sys.exit(a.fn(a) or 0)


if __name__ == "__main__":
    main()
